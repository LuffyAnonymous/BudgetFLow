{
  "name": "04 - Notifications / Import Failed",
  "nodes": [
    {
      "id": "node-0003",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        -100
      ],
      "parameters": {
        "content": "## Import Failed\n\nSingle Responsibility: alert on an intake failure from a channel n8n owns (01-intake \u2014 CSV bulk import, future email import). Note: SMS via iPhone Shortcut and Telegram are handled natively by the app, which already replies to the user directly \u2014 they don't route through this workflow.\n\nInput: { chatId?, source, reason, context? }\nchatId falls back to N8N_OPS_TELEGRAM_CHAT_ID if not supplied by the caller.",
        "height": 260,
        "width": 460,
        "color": 4
      }
    },
    {
      "id": "node-0002",
      "name": "On called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        },
        "inputSource": "passthrough"
      }
    },
    {
      "id": "node-0006",
      "name": "Format Log Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        140
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0007",
              "name": "level",
              "type": "string",
              "value": "WARNING"
            },
            {
              "id": "node-0008",
              "name": "workflow",
              "type": "string",
              "value": "04 - Notifications / Import Failed"
            },
            {
              "id": "node-0009",
              "name": "message",
              "type": "string",
              "value": "={{ 'Source: ' + $json.source + ' — ' + $json.reason }}"
            },
            {
              "id": "node-0010",
              "name": "context",
              "type": "object",
              "value": "={{ { chatId: $json.chatId, source: $json.source } }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0004",
      "name": "Log Entry",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "SELECT_AFTER_IMPORT:05 - Utilities / Logger",
          "cachedResultName": "05 - Utilities / Logger"
        },
        "workflowInputs": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "notesInFlow": true,
      "notes": "After importing, point this at the \"05 - Utilities / Logger\" workflow (n8n assigns IDs on import)."
    },
    {
      "id": "node-0005",
      "name": "Notify (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "alwaysOutputData": true,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": false,
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ \"chat_id\": ($('On called').item.json.chatId || $env.N8N_OPS_TELEGRAM_CHAT_ID), \"text\": ('\u274c Import failed\\nSource: ' + $('On called').item.json.source + '\\nReason: ' + $('On called').item.json.reason) }) }}"
      }
    }
  ],
  "connections": {
    "On called": {
      "main": [
        [
          {
            "node": "Format Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Log Entry": {
      "main": [
        [
          {
            "node": "Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Entry": {
      "main": [
        [
          {
            "node": "Notify (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "tags": []
}
