datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ImportSource {
  SMS
  CSV
  EMAIL
  PDF
  OPEN_BANKING
  APPLE_WALLET
}

enum ImportStatus {
  RECEIVED
  REVIEW_REQUIRED
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
  IGNORED
  PENDING_EVENT
}

enum ImportConfidence {
  HIGH
  MEDIUM
  LOW
}

enum CategoryType {
  INCOME
  FIXED_EXPENSE
  VARIABLE_EXPENSE
  SAVINGS
  DEBT
  REMITTANCE
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
  DEBT_PAYMENT
  TRANSFER
  REMITTANCE
}

enum SavingTxType {
  DEPOSIT
  WITHDRAWAL
}

enum DebtStatus {
  ACTIVE
  PAID
  ARCHIVED
  PAUSED
}

enum SavingGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  PAUSED
}

enum CashFlowDirection {
  OUTFLOW
  INFLOW
}

enum AccountType {
  EMIRATES_NBD
  CASH
}

enum TransactionOrigin {
  MANUAL
  SMS_IMPORT
  EMAIL_IMPORT
  CSV_IMPORT
  SYSTEM
  APPLE_WALLET
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String
  name                 String?
  sessionVersion       Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categories           Category[]
  accounts             Account[]
  transactions         Transaction[]
  budgets              Budget[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  savingGoals          SavingGoal[]
  savingTransactions   SavingTransaction[]
  remittances          Remittance[]
  settings             Setting?
  importSetting        ImportSetting?
  importedTransactions ImportedTransaction[]
  recurringTemplates   RecurringTemplate[]
  recurringOccurrences RecurringOccurrence[]
  notifications        Notification[]
  monthlyRollovers     MonthlyRollover[]
  auditLogs            AuditLog[]
  attachments          Attachment[]
}

model Account {
  id                    String      @id @default(uuid())
  type                  AccountType
  name                  String
  currentBalance        Decimal     @default(0) @db.Decimal(12, 2)
  latestImportedBalance Decimal?    @db.Decimal(12, 2)
  lastSMSImportedAt     DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastUpdated           DateTime    @default(now()) @updatedAt
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  transactions           Transaction[] @relation("AccountTransactions")
  transferToTransactions Transaction[] @relation("TransferToTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
}

model Category {
  id                 String              @id @default(uuid())
  name               String
  type               CategoryType
  budgetGroupKey     String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  budgets            Budget[]
  debts              Debt[]
  savingGoals        SavingGoal[]
  remittances        Remittance[]
  recurringTemplates RecurringTemplate[]
  importSettings     ImportSetting[]     @relation("ImportSettingSalaryCategory")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id                String             @id @default(uuid())
  date              DateTime
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description       String
  amount            Decimal            @db.Decimal(12, 2)
  paymentMethod     String
  notes             String?
  type              TransactionType
  cashFlowDirection CashFlowDirection?
  origin            TransactionOrigin  @default(MANUAL)

  // Account tracking
  accountId   String?
  account     Account? @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  toAccountId String?
  toAccount   Account? @relation("TransferToTransactions", fields: [toAccountId], references: [id], onDelete: SetNull)

  // Import tracking
  importSource         ImportSource?
  adjustedAt           DateTime? // set when user edits an imported transaction
  budgetMonth          String?   // e.g. "2026-08" for reporting/budget month attribution
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtPayment          DebtPayment?
  savingTransaction    SavingTransaction?
  remittance           Remittance?           @relation("RemittanceOriginal")
  remittanceReversal   Remittance?           @relation("RemittanceReversal")
  recurringOccurrence  RecurringOccurrence?
  importedTransactions ImportedTransaction[]
  attachments          Attachment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId, date])
  @@index([userId, budgetMonth])
  @@index([categoryId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([userId, accountId, date])
  @@index([userId, toAccountId, date])
  @@index([userId, type, date])
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  month      String // stored in YYYY-MM format
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month])
  @@index([userId])
}

model Debt {
  id              String        @id @default(uuid())
  name            String
  originalBalance Decimal       @db.Decimal(12, 2)
  currentBalance  Decimal       @db.Decimal(12, 2)
  monthlyPayment  Decimal       @db.Decimal(12, 2)
  dueDay          Int // e.g. 25
  rolloverFeeRate Decimal       @db.Decimal(7, 4) // percentage, e.g. 4.50
  status          DebtStatus    @default(ACTIVE)
  notes           String?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        DebtPayment[]
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, dueDay])
  @@index([categoryId])
}

model DebtPayment {
  id             String       @id @default(uuid())
  debtId         String
  debt           Debt         @relation(fields: [debtId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)
  balanceBefore  Decimal      @db.Decimal(12, 2)
  balanceAfter   Decimal      @db.Decimal(12, 2)
  paymentDate    DateTime
  notes          String?
  transactionId  String?      @unique
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  attachments    Attachment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, debtId, paymentDate])
  @@index([userId, paymentDate])
}

model SavingGoal {
  id            String              @id @default(uuid())
  name          String
  targetAmount  Decimal             @db.Decimal(12, 2)
  currentAmount Decimal             @db.Decimal(12, 2)
  targetDate    DateTime?
  status        SavingGoalStatus    @default(ACTIVE)
  notes         String?
  categoryId    String?
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingTransaction[]
  version       Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@index([userId, targetDate])
  @@index([categoryId])
}

model SavingTransaction {
  id              String       @id @default(uuid())
  savingGoalId    String
  savingGoal      SavingGoal   @relation(fields: [savingGoalId], references: [id], onDelete: Restrict)
  amount          Decimal      @db.Decimal(12, 2)
  balanceBefore   Decimal      @db.Decimal(12, 2)
  balanceAfter    Decimal      @db.Decimal(12, 2)
  type            SavingTxType
  transactionDate DateTime
  notes           String?
  transactionId   String?      @unique
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey  String?
  attachments     Attachment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, savingGoalId, transactionDate])
  @@index([userId, transactionDate])
}

enum RemittanceStatus {
  COMPLETED
  REVERSED
}

model Remittance {
  id                String           @id @default(uuid())
  recipient         String?
  amountSentAed     Decimal          @db.Decimal(12, 2)
  cashOutflowAed    Decimal          @db.Decimal(12, 2) // Immutable cash outflow at creation
  exchangeRate      Decimal?         @db.Decimal(18, 6) // Upgraded precision
  amountReceivedPhp Decimal?         @db.Decimal(12, 2)
  transferFeeAed    Decimal?         @db.Decimal(12, 2)
  transferProvider  String
  transferDate      DateTime
  referenceNumber   String?
  notes             String?
  status            RemittanceStatus @default(COMPLETED)
  archivedAt        DateTime?

  // Reversal details
  reversedAt            DateTime?
  reversalReason        String?
  reversalTransactionId String?      @unique
  reversalTransaction   Transaction? @relation("RemittanceReversal", fields: [reversalTransactionId], references: [id], onDelete: SetNull)

  // Original Transaction relation
  transactionId String?      @unique
  transaction   Transaction? @relation("RemittanceOriginal", fields: [transactionId], references: [id], onDelete: SetNull)

  // Category relation
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency keys
  idempotencyKey         String?
  reversalIdempotencyKey String?

  version     Int          @default(0)
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, idempotencyKey])
  @@unique([userId, reversalIdempotencyKey])
  @@index([userId, status, transferDate])
  @@index([userId, transferDate])
  @@index([userId, transferProvider])
  @@index([userId, recipient])
  @@index([categoryId])
}

model Setting {
  id               String   @id @default(uuid())
  monthlySalary    Decimal  @db.Decimal(12, 2)
  payday           Int
  currency         String   @default("AED")
  timezone         String   @default("Asia/Dubai")
  theme            String   @default("system")
  defaultPageSize  Int      @default(10)
  foodGroupKey     String   @default("FOOD")
  reminderLeadDays Int      @default(3)
  notificationPref Json?
  rolloverPref     Json?
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RecurringOccurrenceStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}

enum RecurringSourceType {
  DEBT
  SAVING_GOAL
  REMITTANCE_PLAN
  GENERAL
}

enum NotificationType {
  UPCOMING_PAYMENT
  PAYMENT_DUE_TODAY
  OVERDUE_PAYMENT
  BUDGET_NEAR_LIMIT
  BUDGET_EXCEEDED
  SAVINGS_GOAL_REACHED
  DEBT_PAID_OFF
  RECURRING_ENTRY_CREATED
  ROLLOVER_AVAILABLE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model RecurringTemplate {
  id              String             @id @default(uuid())
  name            String
  transactionType TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  frequency       RecurringFrequency @default(MONTHLY)
  startDate       DateTime
  endDate         DateTime?
  dueDay          Int?
  autoCreate      Boolean            @default(false)
  reminderEnabled Boolean            @default(true)
  notes           String?
  status          RecurringStatus    @default(ACTIVE)

  sourceType     RecurringSourceType @default(GENERAL)
  sourceEntityId String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  occurrences RecurringOccurrence[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId, status])
  @@index([categoryId])
}

model RecurringOccurrence {
  id             String                    @id @default(uuid())
  scheduledDate  DateTime
  status         RecurringOccurrenceStatus @default(PENDING)
  processedAt    DateTime?
  handledAt      DateTime?
  skippedAt      DateTime?
  failureReason  String?
  idempotencyKey String

  recurringTemplateId String
  template            RecurringTemplate @relation(fields: [recurringTemplateId], references: [id], onDelete: Restrict)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  linkedTransactionId String?      @unique
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@unique([userId, recurringTemplateId, scheduledDate])
  @@index([userId, status, scheduledDate])
  @@index([recurringTemplateId])
}

model Notification {
  id       String               @id @default(uuid())
  type     NotificationType
  title    String
  message  String
  severity NotificationSeverity @default(INFO)
  eventKey String

  relatedEntityType String?
  relatedEntityId   String?
  destinationPath   String?

  readAt      DateTime?
  dismissedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventKey])
  @@index([userId, readAt, dismissedAt])
}

model MonthlyRollover {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMonth       String
  targetMonth       String
  status            String
  copiedBudgetCount Int
  confirmedAt       DateTime @default(now())
  idempotencyKey    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetMonth])
  @@index([userId])
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
  DELETED
  QUARANTINED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  REVERSE
  CHANGE_PASSWORD
  UPLOAD_ATTACHMENT
  DELETE_ATTACHMENT
  LOGIN_SUCCESS
  LOGIN_FAILURE
  // Import Engine
  SMS_IMPORT_RECEIVED
  SMS_IMPORT_DUPLICATE
  SMS_IMPORT_PROCESSED
  SMS_IMPORT_REJECTED
  SMS_IMPORT_FAILED
  IMPORT_TOKEN_GENERATED
  IMPORT_TOKEN_REVOKED
  IMPORT_CONFIRMED
  IMPORT_REJECTED_MANUAL
}

enum AuditEntityType {
  USER
  SETTING
  TRANSACTION
  BUDGET
  DEBT
  DEBT_PAYMENT
  SAVING_GOAL
  SAVING_TRANSACTION
  REMITTANCE
  RECURRING_TEMPLATE
  ATTACHMENT
  // Import Engine
  IMPORTED_TRANSACTION
  IMPORT_SETTING
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType AuditEntityType
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  source     String?         @default("WEB")
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Attachment {
  id           String           @id @default(uuid())
  originalName String
  storageKey   String           @unique
  mimeType     String
  fileSize     Int
  checksum     String
  status       AttachmentStatus @default(PENDING)
  deletedAt    DateTime?

  transactionId String?
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  debtPaymentId String?
  debtPayment   DebtPayment?       @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)
  savingTxId    String?
  savingTx      SavingTransaction? @relation(fields: [savingTxId], references: [id], onDelete: SetNull)
  remittanceId  String?
  remittance    Remittance?        @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([transactionId])
  @@index([debtPaymentId])
  @@index([savingTxId])
  @@index([remittanceId])
}

// ─── Import Engine ─────────────────────────────────────────────────────────────

/// Per-user settings for the SMS import engine.
/// The plaintext token is NEVER stored — only its SHA-256 hash.
model ImportSetting {
  id                      String    @id @default(uuid())
  /// Master switch — if false, all webhook requests are rejected
  enabled                 Boolean   @default(false)
  /// When true, HIGH-confidence imports auto-create transactions without review
  autoImportSalary        Boolean   @default(false)
  /// JSON array of sender strings that are trusted (e.g. ["ENBD", "EmiratesNBD"])
  senderAllowlist         String[]  @default([])
  /// Must point to an INCOME-type category owned by this user
  salaryCategoryId        String?
  salaryCategory          Category? @relation("ImportSettingSalaryCategory", fields: [salaryCategoryId], references: [id], onDelete: SetNull)
  expectedCurrency        String    @default("AED")
  minimumAmount           Decimal?  @db.Decimal(12, 2)
  maximumAmount           Decimal?  @db.Decimal(12, 2)
  rawPayloadRetentionDays Int       @default(30)
  /// Hashed import token (SHA-256 hex). Plaintext returned only on generation/rotation.
  /// @unique ensures no two users ever share the same token hash.
  tokenHash               String?   @unique
  tokenCreatedAt          DateTime?
  tokenRevokedAt          DateTime?
  /// Optional expiry for the token. After this date, resolveUserFromToken returns null.
  tokenExpiresAt          DateTime?
  /// Throttle-updated: only written when stored value is >5 minutes old.
  tokenLastUsedAt         DateTime?
  lastSuccessfulImportAt  DateTime?
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// One canonical record per unique (userId, fingerprint).
/// Duplicate webhook deliveries increment duplicateCount rather than inserting new rows.
model ImportedTransaction {
  id            String            @id @default(uuid())
  source        ImportSource
  institution   String
  status        ImportStatus      @default(RECEIVED)
  confidence    ImportConfidence?
  parserKey     String?
  parserVersion String?

  /// Redacted SMS text — no raw account numbers stored.
  /// Set to null after rawPayloadRetentionDays per owning user's ImportSetting.
  redactedPayload  String?
  /// The raw, unmodified message received from the client.
  rawPayload       String?
  /// SHA-256 of the original raw message (for integrity verification, not display)
  payloadHash      String
  /// Timestamp when redactedPayload was cleared by the retention cleanup job.
  payloadClearedAt DateTime?
  maskedSender     String?
  deviceId         String?

  /// Parsed financial data
  parsedAmount      Decimal? @db.Decimal(12, 2)
  parsedCurrency    String?
  parsedReference   String?
  parsedDescription String?

  /// Timestamps
  receivedAt       DateTime
  serverReceivedAt DateTime?
  financialDate    DateTime?
  budgetMonth      String?   // e.g. "2026-08"
  processedAt      DateTime?
  reviewedAt       DateTime?

  /// Dedup — @@unique enforces one canonical record per fingerprint
  fingerprint     String
  duplicateCount  Int       @default(0)
  lastDuplicateAt DateTime?

  /// Request-level idempotency (Idempotency-Key header)
  idempotencyKey String?

  /// Failure details — safe user-facing message only, never a stack trace
  failureCode    String?
  failureMessage String?

  /// FK lives HERE
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([userId, source, createdAt])
  @@index([userId, receivedAt])
  @@index([userId, fingerprint])
}
