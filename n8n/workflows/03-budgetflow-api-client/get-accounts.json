        "assignments": {
          "assignments": [
            {
              "id": "node-0008",
              "name": "ok",
              "type": "boolean",
              "value": "={{ true }}"
            },
            {
              "id": "node-0009",
              "name": "accounts",
              "type": "array",
              "value": "={{ $json.body.data }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
