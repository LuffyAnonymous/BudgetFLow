      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "node-0010",
              "leftValue": "={{ $env.N8N_SMS_WEBHOOK_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "node-0011",
              "leftValue": "={{ $json.headers['x-budgetflow-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_SMS_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-0012",
      "name": "Format 401 Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        460
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0013",
              "name": "ok",
              "type": "boolean",
              "value": "={{ false }}"
            },
            {
              "id": "node-0014",
              "name": "error",
              "type": "string",
              "value": "Unauthorized"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0015",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1080,
        460
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "node-0006",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = ($input.first() && $input.first().json && $input.first().json.body) || {};\nreturn [{\n  json: {\n    source: \"SMS\",\n    rawText: b.body || b.Body || b.text || \"\",\n    chatId: null,\n    senderHint: b.from || b.From || null,\n    receivedAt: b.receivedAt || new Date().toISOString(),\n  },\n}];"
      }
    },
    {
      "id": "node-0016",
      "name": "Filter Non-Transaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = ($input.first() && $input.first().json) || {};\nconst text = (input.rawText || \"\").toLowerCase();\n\n// EDIT ME: add more non-transaction phrases as you encounter them.\nconst ignorePatterns = [\n  \"otp\",\n  \"one time password\",\n  \"one-time password\",\n  \"verification code\",\n  \"do not share\",\n  \"login code\",\n  \"promotional offer\",\n];\n\nconst isIgnorable = ignorePatterns.some((p) => text.includes(p));\n\nreturn [{\n  json: {\n    ...input,\n    isIgnorable,\n  },\n}];"
      }
    },
    {
