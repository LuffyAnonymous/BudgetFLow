# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/budgetflow?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5435/budgetflow_test?schema=public"

# Authentication
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Seed User Settings
SEED_USER_EMAIL="admin@budgetflow.local"
SEED_USER_PASSWORD="BudgetFlow123!"
SEED_USER_NAME="Arvin"

# Telegram Integrations (Private Bot Webhook)
# Per-user chat linking is self-serve via "/link <code>" (ImportSetting.telegramChatId) —
# no static chat-to-user map needed.
TELEGRAM_BOT_TOKEN="your-bot-token-here"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret-here"
TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"

# System / Automation (n8n) — machine-to-machine secrets
# CRON_SECRET gates /api/cron/health (all-user health sweep) and
# /api/cron/gmail-watch-renew (weekly Gmail push-subscription renewal —
# triggered by GitHub Actions, not n8n; see .github/workflows/gmail-watch-renew.yml).
# IMPORT_CLEANUP_SECRET gates /api/system/import-cleanup (retention cleanup job).
# All bearer tokens compared with a timing-safe check — generate with:
#   openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
IMPORT_CLEANUP_SECRET="your-import-cleanup-secret-here"

# Gmail Import (bank-email auto-import via OAuth + Gmail push notifications)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are from a Google Cloud OAuth
# client (Testing publishing status is fine for personal use — see
# docs/gmail-bank-email-import.md for setup steps and the tradeoffs of
# staying in Testing status: refresh tokens expire after 7 days).
# Redirect URI to register: <your-app-url>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret-here"
# Encrypts the stored refresh token at rest (AES-256-GCM, 32 bytes) — generate with:
#   openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"
# Full Pub/Sub topic resource name Gmail publishes new-mail notifications to,
# e.g. "projects/your-gcp-project/topics/gmail-push" — see docs/gmail-bank-email-import.md.
GOOGLE_PUBSUB_TOPIC="projects/your-gcp-project/topics/gmail-push"
# Verifies inbound Pub/Sub push requests to /api/webhooks/gmail-push (embedded
# in the subscription's configured endpoint URL as ?secret=...) — generate with:
#   openssl rand -hex 32
GMAIL_PUSH_WEBHOOK_SECRET="your-gmail-push-webhook-secret-here"

# Per-user automation API keys (Create Transaction, Debt Payment, Savings, Remittance,
# recurring/rollover/notification triggers) are issued at runtime via
# POST /api/settings/service-api-key — no env var needed. Optional override for key lifetime:
# SERVICE_KEY_EXPIRY_DAYS="365"
