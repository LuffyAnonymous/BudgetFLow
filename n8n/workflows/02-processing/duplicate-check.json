    {
      "id": "node-0007",
      "name": "Check Fingerprint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const original = ($('On called').first() && $('On called').first().json) || {};\nconst searchResult = ($input.first() && $input.first().json) || {};\nconst items = searchResult.items || [];\n\nconst targetAmount = parseFloat(original.amount);\nconst targetDate = original.date ? new Date(original.date) : null;\n\nfunction sameDay(a, b) {\n  if (!a || !b) return false;\n  return a.toISOString().slice(0, 10) === b.toISOString().slice(0, 10);\n}\n\nconst match = items.find((tx) => {\n  const txAmount = parseFloat(tx.amount);\n  const txDate = tx.date ? new Date(tx.date) : null;\n  return Math.abs(txAmount - targetAmount) < 0.01 && sameDay(txDate, targetDate);\n});\n\nreturn [{\n  json: {\n    ...original,\n    isDuplicate: !!match,\n    duplicateTransactionId: match ? match.id : null,\n  },\n}];"
      }
    },
