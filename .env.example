# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/budgetflow?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5435/budgetflow_test?schema=public"

# Authentication
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Seed User Settings
SEED_USER_EMAIL="admin@budgetflow.local"
SEED_USER_PASSWORD="BudgetFlow123!"
SEED_USER_NAME="Arvin"

# Telegram Integrations (Private Bot Webhook)
TELEGRAM_BOT_TOKEN="your-bot-token-here"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret-here"
TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"
TELEGRAM_CHAT_USER_MAP="telegramChatId1:budgetFlowUserId1,telegramChatId2:budgetFlowUserId2"

# iPhone Shortcuts Import
IOS_SHORTCUT_IMPORT_TOKEN="your-shortcut-import-token-here"

# System / Automation (n8n) — machine-to-machine secrets
# CRON_SECRET gates /api/cron/health (all-user health sweep).
# IMPORT_CLEANUP_SECRET gates /api/system/import-cleanup (retention cleanup job).
# Both are bearer tokens compared with a timing-safe check — generate with:
#   openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
IMPORT_CLEANUP_SECRET="your-import-cleanup-secret-here"

# Per-user automation API keys (Create Transaction, Debt Payment, Savings, Remittance,
# recurring/rollover/notification triggers) are issued at runtime via
# POST /api/settings/service-api-key — no env var needed. Optional override for key lifetime:
# SERVICE_KEY_EXPIRY_DAYS="365"
