{
  "name": "03 - BudgetFlow API Client / Health Check",
  "nodes": [
    {
      "id": "node-0003",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        -160
      ],
      "parameters": {
        "content": "## Health Check\n\nSingle Responsibility: call the public GET /api/health endpoint (no auth required — checks app reachability + DB connectivity, src/app/api/health/route.ts) and return a clean contract. A degraded (503, DB unavailable) response is treated the same as any other API failure and routes to System Error — that's a genuine ops-worthy signal, not a false alarm.\n\nDistinct from 06 - Scheduling & Orchestration / System Health Check, which is a scheduled, broader all-user reconciliation sweep using CRON_SECRET. This workflow is a lightweight, on-demand reachability check any flow can call via Execute Workflow.\n\nNo current consumer in the main pipeline — kept available for diagnostics/preflight use.\n\nInput: none required.\nOutput (ok=true): { ok: true, status, database, version, timestamp }\nOutput (ok=false): routes to System Error; caller sees whatever System Error's chain returns.",
        "height": 420,
        "width": 600,
        "color": 4
      }
    },
    {
      "id": "node-0002",
      "name": "On called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        },
        "inputSource": "passthrough"
      }
    },
    {
      "id": "node-0004",
      "name": "GET Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BUDGETFLOW_BASE_URL + '/api/health' }}",
        "authentication": "none",
        "sendHeaders": false,
        "sendQuery": false,
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "node-0005",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "node-0006",
              "leftValue": "={{ $json.statusCode < 400 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-0007",
      "name": "Format Success Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0008",
              "name": "ok",
              "type": "boolean",
              "value": "={{ true }}"
            },
            {
              "id": "node-0009",
              "name": "status",
              "type": "string",
              "value": "={{ $json.body.status }}"
            },
            {
              "id": "node-0015",
              "name": "database",
              "type": "string",
              "value": "={{ $json.body.database }}"
            },
            {
              "id": "node-0016",
              "name": "version",
              "type": "string",
              "value": "={{ $json.body.version }}"
            },
            {
              "id": "node-0017",
              "name": "timestamp",
              "type": "string",
              "value": "={{ $json.body.timestamp }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0010",
      "name": "Format System Error Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1080,
        440
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0011",
              "name": "workflow",
              "type": "string",
              "value": "03 - BudgetFlow API Client / Health Check"
            },
            {
              "id": "node-0012",
              "name": "message",
              "type": "string",
              "value": "={{ 'BudgetFlow health check failed: ' + ($json.body && $json.body.status ? $json.body.status : 'unreachable') + ($json.body && $json.body.database ? (', database: ' + $json.body.database) : '') }}"
            },
            {
              "id": "node-0013",
              "name": "statusCode",
              "type": "number",
              "value": "={{ $json.statusCode }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0014",
      "name": "Notify: System Error",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1360,
        440
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "SELECT_AFTER_IMPORT:04 - Notifications / System Error",
          "cachedResultName": "04 - Notifications / System Error"
        },
        "workflowInputs": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "notesInFlow": true,
      "notes": "After importing, point this at the \"04 - Notifications / System Error\" workflow (n8n assigns IDs on import)."
    }
  ],
  "connections": {
    "On called": {
      "main": [
        [
          {
            "node": "GET Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Health": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Format Success Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format System Error Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format System Error Context": {
      "main": [
        [
          {
            "node": "Notify: System Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "tags": []
}
