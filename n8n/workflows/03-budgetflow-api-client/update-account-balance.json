{
  "name": "03 - BudgetFlow API Client / Update Account Balance",
  "nodes": [
    {
      "id": "node-0003",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        -160
      ],
      "parameters": {
        "content": "## Update Account Balance\n\nSingle Responsibility: confirm and log the post-transaction account balances. This is NOT a second write \u2014 TransactionService.createTransaction already recalculates balances atomically inside the same DB transaction as the insert (see src/server/services/transaction.service.ts). Calling a separate write here would risk double-counting/drift. This step exists purely for pipeline visibility/audit: it fetches current balances and logs them so the automation trail shows the post-transaction state.\n\nRequires a BudgetFlow service API key with the `accounts:read` scope (BUDGETFLOW_SERVICE_API_KEY env var).\n\nInput: output of 03 - Create Transaction (ok, transactionId, amount).\nOutput: { ok, transactionId, amount, accounts: [{ id, name, type, currentBalance }] }",
        "height": 380,
        "width": 560,
        "color": 4
      }
    },
    {
      "id": "node-0002",
      "name": "On called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        },
        "inputSource": "passthrough"
      }
    },
    {
      "id": "node-0004",
      "name": "GET Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BUDGETFLOW_BASE_URL + '/api/accounts' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.BUDGETFLOW_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendQuery": false,
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "node-0005",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "node-0006",
              "leftValue": "={{ $json.statusCode < 400 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-0007",
      "name": "Summarize Balances",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const original = ($('On called').first() && $('On called').first().json) || {};\nconst httpResponse = ($input.first() && $input.first().json) || {};\nconst accounts = (httpResponse.body && httpResponse.body.data) || [];\n\nreturn [{\n  json: {\n    ok: true,\n    transactionId: original.transactionId,\n    amount: original.amount,\n    accounts: accounts.map((a) => ({\n      id: a.id,\n      name: a.name,\n      type: a.type,\n      currentBalance: a.currentBalance,\n    })),\n  },\n}];"
      }
    },
    {
      "id": "node-0026",
      "name": "Format Log Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        180
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0027",
              "name": "level",
              "type": "string",
              "value": "INFO"
            },
            {
              "id": "node-0028",
              "name": "workflow",
              "type": "string",
              "value": "03 - BudgetFlow API Client / Update Account Balance"
            },
            {
              "id": "node-0029",
              "name": "message",
              "type": "string",
              "value": "={{ 'Balances refreshed after transaction ' + $json.transactionId }}"
            },
            {
              "id": "node-0030",
              "name": "context",
              "type": "object",
              "value": "={{ { accounts: $json.accounts } }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0008",
      "name": "Log Entry",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1640,
        180
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "SELECT_AFTER_IMPORT:05 - Utilities / Logger",
          "cachedResultName": "05 - Utilities / Logger"
        },
        "workflowInputs": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "notesInFlow": true,
      "notes": "After importing, point this at the \"05 - Utilities / Logger\" workflow (n8n assigns IDs on import)."
    },
    {
      "id": "node-0031",
      "name": "Restore Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1920,
        180
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0032",
              "name": "ok",
              "type": "boolean",
              "value": "={{ true }}"
            },
            {
              "id": "node-0033",
              "name": "transactionId",
              "type": "string",
              "value": "={{ $('Summarize Balances').item.json.transactionId }}"
            },
            {
              "id": "node-0034",
              "name": "amount",
              "type": "string",
              "value": "={{ $('Summarize Balances').item.json.amount }}"
            },
            {
              "id": "node-0035",
              "name": "accounts",
              "type": "array",
              "value": "={{ $('Summarize Balances').item.json.accounts }}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Logger's own output would otherwise become this workflow's return value \u2014 this node restores the { ok, transactionId, amount, accounts } contract documented above."
    },
    {
      "id": "node-0021",
      "name": "Format System Error Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1080,
        440
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "node-0022",
              "name": "workflow",
              "type": "string",
              "value": "03 - BudgetFlow API Client / Update Account Balance"
            },
            {
              "id": "node-0023",
              "name": "message",
              "type": "string",
              "value": "={{ ($json.body && $json.body.error) ? $json.body.error : 'GET /api/accounts failed' }}"
            },
            {
              "id": "node-0024",
              "name": "statusCode",
              "type": "number",
              "value": "={{ $json.statusCode }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-0025",
      "name": "Notify: System Error",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1360,
        440
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "SELECT_AFTER_IMPORT:04 - Notifications / System Error",
          "cachedResultName": "04 - Notifications / System Error"
        },
        "workflowInputs": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "notesInFlow": true,
      "notes": "After importing, point this at the \"04 - Notifications / System Error\" workflow (n8n assigns IDs on import). Note: the transaction itself was already created successfully at this point \u2014 this only reports that the confirmation/logging step failed."
    }
  ],
  "connections": {
    "On called": {
      "main": [
        [
          {
            "node": "GET Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Accounts": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Summarize Balances",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format System Error Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Balances": {
      "main": [
        [
          {
            "node": "Format Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Log Entry": {
      "main": [
        [
          {
            "node": "Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Entry": {
      "main": [
        [
          {
            "node": "Restore Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format System Error Context": {
      "main": [
        [
          {
            "node": "Notify: System Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "tags": []
}
